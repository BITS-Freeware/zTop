#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
set -e
# Removing the package stops the system agent and turns it off; an upgrade leaves it running,
# and it picks up the new binary the next time it restarts.
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
  systemctl disable --now ztop-agent.service >/dev/null 2>&1 || true
fi
exit 0
